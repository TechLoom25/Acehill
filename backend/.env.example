# Copy to .env (never commit .env)

# Signs login tokens. If unset, one is generated into backend/.secret_key on first run.
# Set it explicitly in production, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Optional. If set, the first-run admin setup screen asks for this value,
# so a stranger who finds a fresh deployment cannot claim the admin account.
SETUP_KEY=

# Time zone used for "today" / "this week" in finance reports
SHOP_TIMEZONE=Africa/Nairobi

# Comma-separated list of frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Africa's Talking (leave AT_API_KEY empty to just print SMS to the console)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
