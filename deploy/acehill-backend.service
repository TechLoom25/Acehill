[Unit]
Description=Acehill Repair API
After=network.target postgresql.service

[Service]
User=acehill
Group=acehill
WorkingDirectory=/opt/acehill/backend
# One worker on purpose: the login rate-limit and first-run lock live in memory.
# 8010 (not 8000) so it doesn't collide with other apps on the droplet.
ExecStart=/opt/acehill/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8010 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
